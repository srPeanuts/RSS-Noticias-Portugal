[{"titulo": "O Reino Unido arrependeu-se do “Brexit”?", "link": "https://www.publico.pt/2026/11/17/mundo/noticia/reino-unido-arrependeuse-brexit-2195168", "fonte": "Público", "data": "2026-11-17T05:30:00+00:00", "resumo": "Dez anos depois do referendo do “Brexit”, o primeiro-ministro britânico reconhece que o país perdeu mais do que ganhou. Londres quer agora aproximar-se de Bruxelas, mas até onde poderá ir?", "cats_feed": ["Podcast Hoje"], "categoria_forcada": "", "motivo": "secção do jornal: podcast"}, {"titulo": "Ataques russos atingem duas pontes em Kiev e deixam zonas da capital sem água e luz", "link": "https://www.publico.pt/2026/11/17/mundo/noticia/ataques-russos-atingem-duas-pontes-kiev-deixam-zonas-capital-agua-luz-2195203", "fonte": "Público", "data": "2026-11-17T00:52:07+00:00", "resumo": "Foram também registadas explosões, na noite desta segunda-feira, nas cidades ucranianas de Smila, Kharkiv, Zaporijjia, Dnipro, Cherkasy e Pavlohrad.", "cats_feed": ["Guerra na Ucrânia"], "categoria_forcada": "", "motivo": "secção do jornal: ucrania"}, {"titulo": "Sexualidade e cancro da próstata: “Há casais que hoje são sexualmente mais felizes sem penetração. Conheceram-se melhor e têm mais prazer do que antes”", "link": "https://expresso.pt/podcasts/o-prazer-e-todo-meu/2026-11-17-ha-casais-que-hoje-sao-sexualmente-mais-felizes-sem-penetracao.-conheceram-se-melhor-e-tem-mais-prazer-do-que-antes-4da1a3d1", "fonte": "Expresso", "data": "2026-11-17T08:05:00+00:00", "resumo": "Mafalda Cruz recebe o urologista Ricardo Godinho neste episódio do podcast O Prazer é Todo Meu , para falar do que raramente se diz em voz alta numa consulta: o que acontece à sexualidade depois do diagnóstico de cancro da próstata, e que soluções existem", "cats_feed": ["O Prazer É Todo Meu"], "categoria_forcada": "", "motivo": "sem palavras de nenhuma categoria"}, {"titulo": "Palavras Cruzadas nº 1604", "link": "https://expresso.pt/jogos/palavras-cruzadas/2026-11-17-palavras-cruzadas-n-1604-4fec5040", "fonte": "Expresso", "data": "2026-11-17T08:00:00+00:00", "resumo": "", "cats_feed": ["Palavras Cruzadas"], "categoria_forcada": "", "motivo": "secção do jornal: palavras cruzadas"}, {"titulo": "Japão e ASEAN manifestam preocupação com \"coação económica\"", "link": "https://www.rtp.pt/noticias/economia/japao-e-asean-manifestam-preocupacao-com-coacao-economica_n1779691", "fonte": "RTP", "data": "2026-11-17T08:28:27+00:00", "resumo": "A primeira-ministra japonesa, Sanae Takaichi, e os líderes da ASEAN manifestaram hoje preocupação com a \"coação económica\" numa declaração conjunta, quando o Japão procura estreitar laços com a região no contexto das tensões com a China.", "cats_feed": ["Economia"], "categoria_forcada": "economia", "motivo": "outro país: japao"}, {"titulo": "Apple vai a tribunal em França por organizar obsolescência programada dos iPhones", "link": "https://www.rtp.pt/noticias/economia/apple-vai-a-tribunal-em-franca-por-organizar-obsolescencia-programada-dos-iphones_n1779681", "fonte": "RTP", "data": "2026-11-17T07:17:49+00:00", "resumo": "A Apple deverá ser julgada em França em junho de 2027, sob suspeita de ter organizado a obsolescência programada de vários modelos de telemóvel iPhone, impedindo a reparação fora das lojas oficiais, foi hoje avançado.", "cats_feed": ["Economia"], "categoria_forcada": "economia", "motivo": "outro país: franca"}, {"titulo": "Japão propõe reserva conjunta de petróleo asiática na cimeira da ASEAN", "link": "https://www.rtp.pt/noticias/economia/japao-propoe-reserva-conjunta-de-petroleo-asiatica-na-cimeira-da-asean_n1779667", "fonte": "RTP", "data": "2026-11-17T06:04:06+00:00", "resumo": "A primeira-ministra japonesa, Sanae Takaichi, propôs hoje que os países asiáticos criem uma reserva conjunta de petróleo utilizando tanques inativos no Japão, numa reunião da Associação das Nações do Sudeste Asiático (ASEAN) em Manila.", "cats_feed": ["Economia"], "categoria_forcada": "economia", "motivo": "outro país: japao"}, {"titulo": "Apple vai a tribunal em França por redução da vida programada dos iPhone", "link": "https://www.jornaldenegocios.pt/empresas/tecnologias/detalhe/apple-vai-a-tribunal-em-franca-por-reducao-da-vida-programada-dos-iphone", "fonte": "Jornal de Negócios", "data": "2026-11-17T08:08:51+00:00", "resumo": "Fabricante vai ainda ser julgada por impedir a reparação dos equipamentos fora das lojas oficiais.", "cats_feed": ["Tecnologias"], "categoria_forcada": "economia", "motivo": "outro país: franca"}, {"titulo": "Cartoon SA 17-11-2026", "link": "https://www.jornaldenegocios.pt/opiniao/cartoon-sa/detalhe/cartoon-sa-17-11-2026", "fonte": "Jornal de Negócios", "data": "2026-11-17T08:00:00+00:00", "resumo": "Cartoon de Luís Afonso", "cats_feed": ["Cartoon SA"], "categoria_forcada": "economia", "motivo": "endereço: /cartoon"}, {"titulo": "China vai fiscalizar pagamentos da BYD, Geely e outros fabricantes de automóveis a fornecedores", "link": "https://www.jornaldenegocios.pt/economia/mundo/asia/detalhe/china-vai-fiscalizar-pagamentos-da-byd-geely-e-outros-fabricantes-de-automoveis-a-fornecedores", "fonte": "Jornal de Negócios", "data": "2026-11-17T07:45:40+00:00", "resumo": "As empresas terão de apresentar até 31 de janeiro de 2027 os relatórios relativos aos pagamentos efetuados em 2026.", "cats_feed": ["Ásia"], "categoria_forcada": "economia", "motivo": "outro país: china"}, {"titulo": "China e Canadá fecham novo acordo tarifário. 254 milhões de produtos canadianos abrangidos", "link": "https://www.jornaldenegocios.pt/economia/mundo/americas/detalhe/china-e-canada-fecham-novo-acordo-tarifario-254-milhoes-de-produtos-canadianos-abrangidos", "fonte": "Jornal de Negócios", "data": "2026-11-17T07:34:58+00:00", "resumo": "As medidas alargam o entendimento comercial alcançado em janeiro, quando Xi e Carney acordaram promover uma nova parceria estratégica, após anos de tensões bilaterais.", "cats_feed": ["Américas"], "categoria_forcada": "economia", "motivo": "outro país: china"}, {"titulo": "Japão propõe reserva conjunta de petróleo asiática", "link": "https://www.jornaldenegocios.pt/economia/mundo/asia/detalhe/japao-propoe-reserva-conjunta-de-petroleo-asiatica", "fonte": "Jornal de Negócios", "data": "2026-11-17T07:28:24+00:00", "resumo": "A primeira-ministra anunciou ainda que o Japão lançará uma iniciativa para criar um mercado comum para a Ásia no domínio da tecnologia avançada.", "cats_feed": ["Ásia"], "categoria_forcada": "economia", "motivo": "outro país: japao"}, {"titulo": "EUA detetam plano iraniano para ataques com bomba a responsáveis da Administração Trump", "link": "https://www.jornaldenegocios.pt/economia/mundo/americas/detalhe/eua-detetam-plano-iraniano-para-ataques-com-bomba-a-responsaveis-da-administracao-trump", "fonte": "Jornal de Negócios", "data": "2026-11-17T07:22:00+00:00", "resumo": "EUA consideram que estes planos são uma tentativa para o Irão ampliar as suas opções de retaliação e não são para já sinais de um ataque iminente.", "cats_feed": ["Américas"], "categoria_forcada": "economia", "motivo": "outro país: eua"}, {"titulo": "Ucrânia ataca ponte da Crimeia pelo segundo dia consecutivo", "link": "https://www.jornaldenegocios.pt/economia/europa/invasao-da-ucrania/detalhe/ucrania-ataca-ponte-da-crimeia-pelo-segundo-dia-consecutivo", "fonte": "Jornal de Negócios", "data": "2026-11-17T07:17:18+00:00", "resumo": "Já na madrugada de segunda-feira, as defesas antiaéreas russas abateram 1.336 drones inimigos num dos maiores ataques ucranianos de toda a guerra.", "cats_feed": ["Invasão da Ucrânia"], "categoria_forcada": "economia", "motivo": "secção do jornal: ucrania"}, {"titulo": "Apple vai a tribunal em França por organizar obsolescência programada dos iPhones", "link": "https://jornaleconomico.sapo.pt/noticias/apple-vai-a-tribunal-em-franca-por-organizar-obsolescencia-programada-dos-iphones/", "fonte": "Jornal Económico", "data": "2026-11-17T09:00:21+00:00", "resumo": "A obsolescência programada refere-se às técnicas utilizadas pelos fabricantes para reduzir deliberadamente a vida útil dos respetivos produtos, geralmente aparelhos eletrónicos, obrigando os consumidores a deitar fora e a comprar novos com maior frequência.", "cats_feed": ["Empresas", "Sapo Tecnologia", "Tecnologia", "bens de consumo", "Ciência e tecnologia", "crime", "crime económico", "economia", "Electrónica", "empresas", "Informação sobre empresas", "julgamentos", "Justiça e direitos", "lei e justiça", "Negócios e Finanças", "Organizações internacionais", "telecomunicações", "Tribunal"], "categoria_forcada": "economia", "motivo": "outro país: franca"}, {"titulo": "China vai fiscalizar pagamentos de 17 fabricantes automóveis a fornecedores", "link": "https://jornaleconomico.sapo.pt/noticias/china-vai-fiscalizar-pagamentos-de-17-fabricantes-automoveis-a-fornecedores/", "fonte": "Jornal Económico", "data": "2026-11-17T08:57:48+00:00", "resumo": "A Associação Chinesa de Fabricantes de Automóveis (CAAM) anunciou hoje que realizará avaliações anuais, por determinação do ministério da Indústria e Tecnologia da Informação, para verificar o cumprimento do compromisso de pagamento num prazo máximo de 60 dias.", "cats_feed": ["Mundo", "Sapo Atualidade", "automóvel", "economia", "Negócios e Finanças"], "categoria_forcada": "economia", "motivo": "outro país: china"}, {"titulo": "Líder britânico admite fracasso do Brexit na véspera de cimeira sobre relações com UE", "link": "https://www.dn.pt/internacional/lder-britnico-admite-fracasso-do-brexit-na-vspera-de-cimeira-sobre-relaes-com-ue", "fonte": "Diário de Notícias", "data": "2026-11-17T08:46:06+00:00", "resumo": "", "cats_feed": ["Internacional"], "categoria_forcada": "", "motivo": "secção do jornal: internacional"}, {"titulo": "Apple vai a julgamento em França por suspeitas de obsolescência programada dos iPhones", "link": "https://www.dn.pt/sociedade/apple-vai-a-julgamento-em-frana-por-suspeitas-de-obsolescncia-programada-dos-iphones", "fonte": "Diário de Notícias", "data": "2026-11-17T08:45:09+00:00", "resumo": "", "cats_feed": ["Sociedade", "Atualidade", "Internacional", "dinheiro vivo"], "categoria_forcada": "", "motivo": "outro país: franca"}, {"titulo": "Taiwan deteta dois aviões militares russos perto da ilha", "link": "https://www.dn.pt/internacional/taiwan-deteta-dois-avies-militares-russos-perto-da-ilha", "fonte": "Diário de Notícias", "data": "2026-11-17T08:22:01+00:00", "resumo": "", "cats_feed": ["Internacional", "Atualidade"], "categoria_forcada": "", "motivo": "secção do jornal: internacional"}, {"titulo": "Em seis meses, mais de mil carteiras de identidade do novo modelo são emitidas para brasileiros em Portugal", "link": "https://dnbrasil.dn.pt/passaporte-dn-brasil/em-seis-meses-mais-de-mil-carteiras-de-identidade-do-novo-modelo-so-emitidas-para-brasileiros-em-portugal", "fonte": "Diário de Notícias", "data": "2026-11-17T08:00:00+00:00", "resumo": "", "cats_feed": ["Passaporte DN Brasil", "DN Brasil", "Diplomacia BR"], "categoria_forcada": "", "motivo": "sem palavras de nenhuma categoria"}, {"titulo": "Bolsa de Tóquio encerra com Nikkei a cair 1,34%", "link": "https://www.noticiasaominuto.com/economia/3085233/bolsa-de-toquio-encerra-com-nikkei-a-cair-1-34#utm_source=rss-economia&utm_medium=rss&utm_campaign=rssfeed", "fonte": "Notícias ao Minuto", "data": "2026-11-17T08:35:54+00:00", "resumo": "", "cats_feed": ["Economia"], "categoria_forcada": "economia", "motivo": "outro país: toquio"}, {"titulo": "China aproveita cimeira da APEC em Shenzhen para reforçar influência", "link": "https://www.noticiasaominuto.com/mundo/3085221/china-aproveita-cimeira-da-apec-em-shenzhen-para-reforcar-influencia-global#utm_source=rss-economia&utm_medium=rss&utm_campaign=rssfeed", "fonte": "Notícias ao Minuto", "data": "2026-11-17T08:34:54+00:00", "resumo": "", "cats_feed": ["Economia"], "categoria_forcada": "economia", "motivo": "outro país: china"}, {"titulo": "Japão e ASEAN manifestam preocupação com \"coação económica\"", "link": 